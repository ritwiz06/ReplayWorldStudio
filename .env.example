# Copy to .env for local overrides. Names and safe local defaults only - never put real secrets here.

# API process (services/api). Bind to loopback unless you deliberately expose it.
RWS_API_HOST=127.0.0.1
RWS_API_PORT=8000
# Comma-separated browser origins allowed by CORS (the Vite dev and preview servers).
RWS_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
# Directory holding scene fixtures. Defaults to <repo>/fixtures when unset.
# RWS_FIXTURES_DIR=

# Web app (apps/web). Vite exposes only VITE_-prefixed variables to the browser.
VITE_API_BASE_URL=http://127.0.0.1:8000
