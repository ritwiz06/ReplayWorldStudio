# Copy to .env for local overrides. Names and safe local defaults only - never put real secrets here.
# .env is git-ignored. The API process reads RWS_* and VOYAGER_* names from it; the browser only
# ever sees VITE_-prefixed names, so the Voyager key below never reaches browser code.

# API process (services/api). Bind to loopback unless you deliberately expose it.
RWS_API_HOST=127.0.0.1
RWS_API_PORT=8000
# Comma-separated browser origins allowed by CORS (the Vite dev and preview servers).
RWS_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
# Directory holding scene fixtures. Defaults to <repo>/fixtures when unset.
# RWS_FIXTURES_DIR=
# Catalog library (models are served from here; generated models are written to its generated/
# folder). Defaults to <repo>/assets/catalog.
# RWS_CATALOG_DIR=

# Language proposals (GEN-01): describing objects and changing them with words.
# Your ASU Voyager API key. Put the real key ONLY in your local .env, never in this file, in Git,
# in fixtures or in browser code. Without a key, proposals are off and the object builder still works.
VOYAGER_API_KEY=
# OpenAI-compatible endpoint and exact model ID (defaults shown).
# VOYAGER_BASE_URL=https://openai.rc.asu.edu/v1
# VOYAGER_MODEL=qwen3-235b-a22b-instruct-2507
# voyager (default when a key is set) | off | recorded (offline test fixture: replays saved answers;
# never live AI).
# RWS_ASSIST_PROVIDER=
# Seconds to wait for one proposal (large structured answers can take a minute or more).
# RWS_ASSIST_TIMEOUT_S=150

# Web app (apps/web). Vite exposes only VITE_-prefixed variables to the browser.
VITE_API_BASE_URL=http://127.0.0.1:8000
