{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:replay-world:contracts:0.4.0",
  "title": "ReplayWorldContracts",
  "description": "Replay World Studio contracts, schema version 0.4.0. Generated from packages/contracts/python - do not edit by hand.",
  "type": "object",
  "properties": {
    "Project": {
      "$ref": "#/$defs/Project"
    },
    "HealthResponse": {
      "$ref": "#/$defs/HealthResponse"
    },
    "ValidationReport": {
      "$ref": "#/$defs/ValidationReport"
    },
    "UpgradeReport": {
      "$ref": "#/$defs/UpgradeReport"
    },
    "ValidationErrorResponse": {
      "$ref": "#/$defs/ValidationErrorResponse"
    }
  },
  "required": [
    "Project",
    "HealthResponse",
    "ValidationReport",
    "UpgradeReport",
    "ValidationErrorResponse"
  ],
  "additionalProperties": false,
  "$defs": {
    "AssetSource": {
      "additionalProperties": false,
      "description": "Where an asset definition came from. Vendor and third-party assets must cite it.",
      "properties": {
        "kind": {
          "enum": [
            "synthetic",
            "in_house",
            "vendor",
            "third_party"
          ],
          "type": "string"
        },
        "author": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        "reference": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "URL, catalogue number or document that identifies the original."
        }
      },
      "required": [
        "kind",
        "author",
        "reference"
      ],
      "title": "AssetSource",
      "type": "object"
    },
    "AxisChange": {
      "additionalProperties": false,
      "description": "One dimension axis before and after an edit. ``before`` keeps the replaced evidence.",
      "properties": {
        "axis": {
          "enum": [
            "width",
            "height",
            "depth"
          ],
          "type": "string"
        },
        "before": {
          "$ref": "#/$defs/Length"
        },
        "after": {
          "$ref": "#/$defs/Length"
        }
      },
      "required": [
        "axis",
        "before",
        "after"
      ],
      "title": "AxisChange",
      "type": "object"
    },
    "CatalogAsset": {
      "additionalProperties": false,
      "description": "A reusable definition that scene objects instantiate by referencing its ``id``.\n\n``nominal_dimensions`` describe the catalogued item. Each scene object keeps its own\n``dimensions`` because an installed instance may be measured differently; differences\nare surfaced, never averaged away.",
      "properties": {
        "id": {
          "description": "Stable, lowercase identifier. Never reused for a different entity.",
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": [
            "structure",
            "equipment",
            "reference",
            "walkway",
            "keep_clear"
          ],
          "type": "string"
        },
        "visual": {
          "discriminator": {
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PlaceholderBoxVisual"
            },
            {
              "$ref": "#/$defs/GltfVisual"
            }
          ],
          "type": "object"
        },
        "nominal_dimensions": {
          "$ref": "#/$defs/Dimensions"
        },
        "source": {
          "$ref": "#/$defs/AssetSource"
        },
        "rights": {
          "$ref": "#/$defs/UsageRights"
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "visual",
        "nominal_dimensions",
        "source",
        "rights"
      ],
      "title": "CatalogAsset",
      "type": "object"
    },
    "Dimensions": {
      "additionalProperties": false,
      "description": "Physical bounding-box extents along the object's local axes, each with its own evidence.\n\n``width`` is local X, ``height`` is local Y (up) and ``depth`` is local Z, all before\nrotation. Every placed object needs all three; an axis nobody has established is recorded\nwith origin ``default`` and an explanation, never left blank or silently guessed.",
      "properties": {
        "width": {
          "$ref": "#/$defs/Length"
        },
        "height": {
          "$ref": "#/$defs/Length"
        },
        "depth": {
          "$ref": "#/$defs/Length"
        }
      },
      "required": [
        "width",
        "height",
        "depth"
      ],
      "title": "Dimensions",
      "type": "object"
    },
    "EulerRotation": {
      "additionalProperties": false,
      "description": "Rotation in radians, applied as R = Rx(x) * Ry(y) * Rz(z) (Three.js 'XYZ' order).",
      "properties": {
        "order": {
          "const": "XYZ",
          "type": "string"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      },
      "required": [
        "order",
        "x",
        "y",
        "z"
      ],
      "title": "EulerRotation",
      "type": "object"
    },
    "FixtureLabel": {
      "additionalProperties": false,
      "description": "Marks development data so it is never mistaken for a real project.",
      "properties": {
        "kind": {
          "enum": [
            "foundation",
            "demonstration"
          ],
          "type": "string"
        },
        "note": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "note"
      ],
      "title": "FixtureLabel",
      "type": "object"
    },
    "GltfVisual": {
      "additionalProperties": false,
      "description": "A binary glTF (.glb) file from the catalog library, drawn at an instance's dimensions.\n\nAuthoring conventions, checked against ``model_bounds_m``:\n\n* units: file coordinates times ``metres_per_model_unit`` are metres (glTF's unit is 1 m);\n* orientation: +Y is up and the equipment's front faces +Z, as glTF recommends;\n* origin: the bottom-centre of the model's bounding box is at (0, 0, 0).\n\nFit: the renderer scales the model on each axis so its bounds equal the instance's recorded\n``dimensions``. Physical dimensions are never derived from the model. When a per-axis scale\ndeparts from 1 by more than ``max_fit_distortion``, the visual is flagged as stretched.",
      "properties": {
        "type": {
          "const": "gltf",
          "type": "string"
        },
        "uri": {
          "description": "Path of a .glb file relative to the catalog library root.",
          "pattern": "^(?:[a-z0-9][a-z0-9_-]{0,63}/){0,4}[a-z0-9][a-z0-9_-]{0,63}\\.glb$",
          "type": "string"
        },
        "sha256": {
          "description": "SHA-256 of the exact file bytes, lowercase hex.",
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "metres_per_model_unit": {
          "description": "Metres per model unit.",
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "up_axis": {
          "const": "+Y",
          "type": "string"
        },
        "front_axis": {
          "const": "+Z",
          "type": "string"
        },
        "origin": {
          "const": "bottom_centre",
          "type": "string"
        },
        "model_bounds_m": {
          "$ref": "#/$defs/ModelBounds"
        },
        "fit": {
          "const": "scale_to_dimensions",
          "type": "string"
        },
        "max_fit_distortion": {
          "description": "Largest per-axis scale departure from 1 still shown as faithful.",
          "maximum": 0.5,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "type",
        "uri",
        "sha256",
        "metres_per_model_unit",
        "up_axis",
        "front_axis",
        "origin",
        "model_bounds_m",
        "fit",
        "max_fit_distortion"
      ],
      "title": "GltfVisual",
      "type": "object"
    },
    "HealthResponse": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "ok",
          "type": "string"
        },
        "service": {
          "const": "replay-world-api",
          "type": "string"
        },
        "api_version": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        "schema_version": {
          "const": "0.4.0",
          "type": "string"
        }
      },
      "required": [
        "status",
        "service",
        "api_version",
        "schema_version"
      ],
      "title": "HealthResponse",
      "type": "object"
    },
    "KnownParameter": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "const": "known",
          "type": "string"
        },
        "id": {
          "description": "Stable, lowercase identifier. Never reused for a different entity.",
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "label": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        "unit": {
          "enum": [
            "m",
            "s",
            "kg",
            "rad",
            "m/s",
            "1"
          ],
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "origin": {
          "enum": [
            "measured",
            "user_supplied",
            "supplier",
            "inferred",
            "default"
          ],
          "type": "string"
        },
        "source_ref": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "review_status": {
          "enum": [
            "unreviewed",
            "confirmed"
          ],
          "type": "string"
        },
        "uncertainty": {
          "anyOf": [
            {
              "$ref": "#/$defs/UncertaintyBounds"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "state",
        "id",
        "label",
        "unit",
        "value",
        "origin",
        "source_ref",
        "review_status",
        "uncertainty"
      ],
      "title": "KnownParameter",
      "type": "object"
    },
    "Length": {
      "additionalProperties": false,
      "description": "A strictly positive length in metres that carries its own evidence.",
      "properties": {
        "value_m": {
          "description": "Strictly positive length in metres.",
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "origin": {
          "enum": [
            "measured",
            "user_supplied",
            "supplier",
            "inferred",
            "default"
          ],
          "type": "string"
        },
        "source_ref": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "review_status": {
          "enum": [
            "unreviewed",
            "confirmed"
          ],
          "type": "string"
        },
        "uncertainty_m": {
          "anyOf": [
            {
              "$ref": "#/$defs/UncertaintyBounds"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "value_m",
        "origin",
        "source_ref",
        "review_status",
        "uncertainty_m"
      ],
      "title": "Length",
      "type": "object"
    },
    "ModelBounds": {
      "additionalProperties": false,
      "description": "Axis-aligned bounds of a model in metres, in its own authored frame.",
      "properties": {
        "min": {
          "$ref": "#/$defs/Vec3"
        },
        "max": {
          "$ref": "#/$defs/Vec3"
        }
      },
      "required": [
        "min",
        "max"
      ],
      "title": "ModelBounds",
      "type": "object"
    },
    "ObjectAdded": {
      "additionalProperties": false,
      "description": "A new object was placed: an instance of a catalog asset or a copy of another object.",
      "properties": {
        "type": {
          "const": "object_added",
          "type": "string"
        },
        "revision": {
          "description": "Scene revision this edit produced.",
          "minimum": 1,
          "type": "integer"
        },
        "object_id": {
          "description": "Stable, lowercase identifier. Never reused for a different entity.",
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "asset_id": {
          "anyOf": [
            {
              "description": "Stable, lowercase identifier. Never reused for a different entity.",
              "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "duplicate_of": {
          "anyOf": [
            {
              "description": "Stable, lowercase identifier. Never reused for a different entity.",
              "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Object this one was copied from; null for a new catalog instance."
        }
      },
      "required": [
        "type",
        "revision",
        "object_id",
        "asset_id",
        "duplicate_of"
      ],
      "title": "ObjectAdded",
      "type": "object"
    },
    "ObjectEdited": {
      "additionalProperties": false,
      "description": "An existing object was moved, rotated or resized in the editor.\n\nA changed axis always becomes ``user_supplied`` and unreviewed, because a person typed or\ndragged the new value; the previous value and its evidence stay in ``before``.",
      "properties": {
        "type": {
          "const": "object_edited",
          "type": "string"
        },
        "revision": {
          "description": "Scene revision this edit produced.",
          "minimum": 1,
          "type": "integer"
        },
        "object_id": {
          "description": "Stable, lowercase identifier. Never reused for a different entity.",
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "transform": {
          "anyOf": [
            {
              "$ref": "#/$defs/TransformChange"
            },
            {
              "type": "null"
            }
          ]
        },
        "dimensions": {
          "items": {
            "$ref": "#/$defs/AxisChange"
          },
          "type": "array"
        }
      },
      "required": [
        "type",
        "revision",
        "object_id",
        "transform",
        "dimensions"
      ],
      "title": "ObjectEdited",
      "type": "object"
    },
    "ObjectRemoved": {
      "additionalProperties": false,
      "description": "An object was removed. Its last state, evidence included, is kept here.",
      "properties": {
        "type": {
          "const": "object_removed",
          "type": "string"
        },
        "revision": {
          "description": "Scene revision this edit produced.",
          "minimum": 1,
          "type": "integer"
        },
        "object": {
          "$ref": "#/$defs/SceneObject"
        }
      },
      "required": [
        "type",
        "revision",
        "object"
      ],
      "title": "ObjectRemoved",
      "type": "object"
    },
    "PlaceholderBoxVisual": {
      "additionalProperties": false,
      "description": "A plain labelled box sized from each instance's dimensions. Always provisional.",
      "properties": {
        "type": {
          "const": "placeholder_box",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "PlaceholderBoxVisual",
      "type": "object"
    },
    "Project": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.4.0",
          "type": "string"
        },
        "id": {
          "description": "Stable, lowercase identifier. Never reused for a different entity.",
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        "units": {
          "$ref": "#/$defs/UnitSystem"
        },
        "world_frame": {
          "$ref": "#/$defs/WorldFrame"
        },
        "fixture": {
          "anyOf": [
            {
              "$ref": "#/$defs/FixtureLabel"
            },
            {
              "type": "null"
            }
          ]
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceDocument"
          },
          "type": "array"
        },
        "catalog": {
          "items": {
            "$ref": "#/$defs/CatalogAsset"
          },
          "type": "array"
        },
        "scene": {
          "$ref": "#/$defs/Scene"
        }
      },
      "required": [
        "schema_version",
        "id",
        "name",
        "units",
        "world_frame",
        "fixture",
        "sources",
        "catalog",
        "scene"
      ],
      "title": "Project",
      "type": "object"
    },
    "Scene": {
      "additionalProperties": false,
      "description": "Placed objects plus the record of every edit in effect.\n\n``revision`` advances by one for every accepted edit, undo and redo, so a command prepared\nagainst an older revision is always detected. ``edit_log`` lists, oldest first, the edits\nthat produced the current objects. An undone edit leaves the log, so the revisions of its\nrecords may have gaps; the log never describes values the scene does not hold.",
      "properties": {
        "id": {
          "description": "Stable, lowercase identifier. Never reused for a different entity.",
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        "revision": {
          "description": "Advanced by one for every accepted edit, undo and redo.",
          "minimum": 0,
          "type": "integer"
        },
        "objects": {
          "items": {
            "$ref": "#/$defs/SceneObject"
          },
          "type": "array"
        },
        "edit_log": {
          "items": {
            "discriminator": {
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ObjectEdited"
              },
              {
                "$ref": "#/$defs/ObjectAdded"
              },
              {
                "$ref": "#/$defs/ObjectRemoved"
              }
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "revision",
        "objects",
        "edit_log"
      ],
      "title": "Scene",
      "type": "object"
    },
    "SceneObject": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Stable, lowercase identifier. Never reused for a different entity.",
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": [
            "structure",
            "equipment",
            "reference",
            "walkway",
            "keep_clear"
          ],
          "type": "string"
        },
        "asset_id": {
          "anyOf": [
            {
              "description": "Stable, lowercase identifier. Never reused for a different entity.",
              "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Catalog asset this object instantiates; null for scene geometry."
        },
        "transform": {
          "$ref": "#/$defs/Transform"
        },
        "dimensions": {
          "$ref": "#/$defs/Dimensions"
        },
        "parameters": {
          "items": {
            "discriminator": {
              "propertyName": "state"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/KnownParameter"
              },
              {
                "$ref": "#/$defs/UnknownParameter"
              }
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "asset_id",
        "transform",
        "dimensions",
        "parameters"
      ],
      "title": "SceneObject",
      "type": "object"
    },
    "SourceDocument": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Stable, lowercase identifier. Never reused for a different entity.",
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "synthetic",
            "dxf",
            "pdf",
            "png"
          ],
          "type": "string"
        },
        "filename": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_to_world": {
          "$ref": "#/$defs/SourceToWorldTransform"
        },
        "import_warnings": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "filename",
        "sha256",
        "source_to_world",
        "import_warnings"
      ],
      "title": "SourceDocument",
      "type": "object"
    },
    "SourceToWorldTransform": {
      "additionalProperties": false,
      "description": "Maps a 2D source plan (drawing) point to world metres.\n\nSteps, applied in order to source point (u, v):\n1. scale by ``metres_per_source_unit``;\n2. axis convention ``plan_xy_to_world_x_neg_z``: source +X -> world +X, source +Y -> world -Z;\n3. rotate about world +Y by ``rotation_about_world_y_rad`` (right-hand rule);\n4. translate by ``translation_m`` (its y component is the plan's floor elevation).",
      "properties": {
        "convention": {
          "const": "plan_xy_to_world_x_neg_z",
          "type": "string"
        },
        "source_unit": {
          "enum": [
            "m",
            "cm",
            "mm",
            "in",
            "ft"
          ],
          "type": "string"
        },
        "metres_per_source_unit": {
          "description": "Metres per one source unit.",
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "rotation_about_world_y_rad": {
          "type": "number"
        },
        "translation_m": {
          "$ref": "#/$defs/Vec3"
        }
      },
      "required": [
        "convention",
        "source_unit",
        "metres_per_source_unit",
        "rotation_about_world_y_rad",
        "translation_m"
      ],
      "title": "SourceToWorldTransform",
      "type": "object"
    },
    "Transform": {
      "additionalProperties": false,
      "description": "World placement; ``position_m`` locates the bounding-box bottom-centre.",
      "properties": {
        "position_m": {
          "$ref": "#/$defs/Vec3"
        },
        "rotation_rad": {
          "$ref": "#/$defs/EulerRotation"
        }
      },
      "required": [
        "position_m",
        "rotation_rad"
      ],
      "title": "Transform",
      "type": "object"
    },
    "TransformChange": {
      "additionalProperties": false,
      "description": "An object's placement before and after an edit.",
      "properties": {
        "before": {
          "$ref": "#/$defs/Transform"
        },
        "after": {
          "$ref": "#/$defs/Transform"
        }
      },
      "required": [
        "before",
        "after"
      ],
      "title": "TransformChange",
      "type": "object"
    },
    "UncertaintyBounds": {
      "additionalProperties": false,
      "description": "Inclusive bounds in the unit of the value they qualify. Not a calibrated probability.",
      "properties": {
        "lower": {
          "type": "number"
        },
        "upper": {
          "type": "number"
        }
      },
      "required": [
        "lower",
        "upper"
      ],
      "title": "UncertaintyBounds",
      "type": "object"
    },
    "UnitSystem": {
      "additionalProperties": false,
      "properties": {
        "length": {
          "const": "m",
          "type": "string"
        },
        "time": {
          "const": "s",
          "type": "string"
        },
        "mass": {
          "const": "kg",
          "type": "string"
        },
        "angle": {
          "const": "rad",
          "type": "string"
        }
      },
      "required": [
        "length",
        "time",
        "mass",
        "angle"
      ],
      "title": "UnitSystem",
      "type": "object"
    },
    "UnknownParameter": {
      "additionalProperties": false,
      "description": "A required quantity that has not been established. It carries no value.",
      "properties": {
        "state": {
          "const": "unknown",
          "type": "string"
        },
        "id": {
          "description": "Stable, lowercase identifier. Never reused for a different entity.",
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "label": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        "unit": {
          "enum": [
            "m",
            "s",
            "kg",
            "rad",
            "m/s",
            "1"
          ],
          "type": "string"
        },
        "reason": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "state",
        "id",
        "label",
        "unit",
        "reason"
      ],
      "title": "UnknownParameter",
      "type": "object"
    },
    "UpgradeReport": {
      "additionalProperties": false,
      "description": "An older project document upgraded to the current contract and validated, for review.\n\nNothing is saved or replaced by producing this report; the client shows ``notes`` and lets\nthe user decide whether to open or download the upgraded ``project``.",
      "properties": {
        "from_version": {
          "description": "Schema version of the submitted document.",
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        "to_version": {
          "const": "0.4.0",
          "type": "string"
        },
        "notes": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "project": {
          "$ref": "#/$defs/Project"
        },
        "validation": {
          "$ref": "#/$defs/ValidationReport"
        }
      },
      "required": [
        "from_version",
        "to_version",
        "notes",
        "project",
        "validation"
      ],
      "title": "UpgradeReport",
      "type": "object"
    },
    "UsageRights": {
      "additionalProperties": false,
      "description": "Explicit usage rights. An unknown license is recorded as NOASSERTION, never omitted.",
      "properties": {
        "license": {
          "description": "A single SPDX license identifier (e.g. CC0-1.0), a LicenseRef-* identifier for custom terms, or NOASSERTION when the license is not known.",
          "pattern": "^(NOASSERTION|LicenseRef-[A-Za-z0-9.-]+|[A-Za-z0-9][A-Za-z0-9.+-]*)$",
          "type": "string"
        },
        "redistribution": {
          "enum": [
            "allowed",
            "restricted",
            "unknown"
          ],
          "type": "string"
        },
        "attribution": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "terms_ref": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where the governing terms are recorded (URL, agreement or note)."
        }
      },
      "required": [
        "license",
        "redistribution",
        "attribution",
        "terms_ref"
      ],
      "title": "UsageRights",
      "type": "object"
    },
    "ValidationErrorResponse": {
      "additionalProperties": false,
      "description": "Body of every HTTP 422 response. Rejected input is not echoed back.",
      "properties": {
        "detail": {
          "items": {
            "$ref": "#/$defs/ValidationIssue"
          },
          "type": "array"
        }
      },
      "required": [
        "detail"
      ],
      "title": "ValidationErrorResponse",
      "type": "object"
    },
    "ValidationIssue": {
      "additionalProperties": false,
      "description": "One reason a request was rejected. ``loc`` is the path to the offending value.",
      "properties": {
        "loc": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "type": "array"
        },
        "msg": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "loc",
        "msg",
        "type"
      ],
      "title": "ValidationIssue",
      "type": "object"
    },
    "ValidationReport": {
      "additionalProperties": false,
      "description": "Summary returned when the API accepts a project document.",
      "properties": {
        "valid": {
          "const": true,
          "type": "boolean"
        },
        "schema_version": {
          "const": "0.4.0",
          "type": "string"
        },
        "project_id": {
          "description": "Stable, lowercase identifier. Never reused for a different entity.",
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "object_count": {
          "minimum": 0,
          "type": "integer"
        },
        "asset_count": {
          "minimum": 0,
          "type": "integer"
        },
        "model_file_count": {
          "description": "glTF files found with matching sha256.",
          "minimum": 0,
          "type": "integer"
        },
        "known_parameter_count": {
          "minimum": 0,
          "type": "integer"
        },
        "unknown_parameter_count": {
          "minimum": 0,
          "type": "integer"
        },
        "edit_record_count": {
          "description": "Records in the scene edit log.",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "valid",
        "schema_version",
        "project_id",
        "object_count",
        "asset_count",
        "model_file_count",
        "known_parameter_count",
        "unknown_parameter_count",
        "edit_record_count"
      ],
      "title": "ValidationReport",
      "type": "object"
    },
    "Vec3": {
      "additionalProperties": false,
      "description": "A point or offset in world metres.",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "title": "Vec3",
      "type": "object"
    },
    "WorldFrame": {
      "additionalProperties": false,
      "properties": {
        "handedness": {
          "const": "right",
          "type": "string"
        },
        "up_axis": {
          "const": "+Y",
          "type": "string"
        },
        "floor_plane": {
          "const": "XZ",
          "type": "string"
        }
      },
      "required": [
        "handedness",
        "up_axis",
        "floor_plane"
      ],
      "title": "WorldFrame",
      "type": "object"
    }
  }
}
