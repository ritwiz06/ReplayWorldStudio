# --- Dependencies and build output ---
node_modules/
dist/
dist-public/
dist-local/
build/
*.tsbuildinfo
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# --- Tool caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.vite/
.eslintcache
coverage/
apps/web/test-results/
bench-results/
apps/web/playwright-report/
apps/web/blob-report/

# --- Credentials and local configuration (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- Local project data, run outputs and generated caches ---
# Projects created while using the app, simulation runs and job logs stay local.
data/
runs/
var/
*.sqlite
*.sqlite3
*.db

# --- Customer or third-party drawings (use fixtures/ for synthetic or permissioned samples) ---
uploads/
drawings/
customer-data/
# The synthetic DXF fixtures are made by scripts/build_dxf_fixtures.py, not uploaded.
!fixtures/drawings/

# --- Model weights and large binary artefacts ---
# Root-level only: assets/catalog/models/ holds the committed catalog glTF files.
/models/
*.safetensors
*.gguf
*.ckpt
*.pt
*.pth
*.onnx

# --- OS / editor noise ---
.DS_Store
.idea/
*.swp

# --- Generated object models (GEN-01): built locally from specifications recorded in projects ---
assets/catalog/generated/
# Models people attach (ENR-01): their own files, never committed.
assets/catalog/uploaded/
apps/web/.visit/
